# ============================================================================
# MANDALA DIGITAL BAZAAR — ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# Copy this file to .env.local for local development or configure in Vercel.
# NEVER commit real secrets to GitHub or expose server secrets via NEXT_PUBLIC_ / VITE_.

# 1. Database (MongoDB Atlas with Replica Set for Multi-Document Transactions)
MONGODB_URI=""

# 2. Authentication & Session Security
AUTH_SECRET=""
SESSION_COOKIE_NAME="mdb_session_token"
ENCRYPTION_SECRET_KEY=""

# 3. Application URL & Regional Settings
APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Asia/Kathmandu"
DEFAULT_CURRENCY="NPR"

# 4. Email Delivery Provider (Resend / Postmark / SMTP HTTP API)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@mandaladigital.com.np"

# 5. Private S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / Backblaze B2)
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="ap-south-1"
OBJECT_STORAGE_BUCKET="mandala-digital-private"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_PUBLIC_BASE_URL=""

# 6. Distributed Rate Limiting Store (Upstash Redis or compatible HTTP store)
RATE_LIMIT_STORE_URL=""
RATE_LIMIT_STORE_TOKEN=""

# 7. Super Admin One-Time Bootstrap (Used only by scripts/bootstrap-super-admin.ts)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

